    "Mouse and touch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse and touch"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột và cảm ứng"
          }
        }
      }
    },
    "Input explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe in from the left edge to open the Guacamole menu. Choose absolute touchscreen mouse or relative trackpad mode. Use a Bluetooth mouse if available; pinch to zoom. Input is handled by the gateway client."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt từ mép trái để mở menu Guacamole. Chọn chế độ chuột cảm ứng trực tiếp hoặc chuột tương đối (trackpad). Dùng chuột Bluetooth nếu có; chụm hai ngón để thu phóng. Các thao tác do gateway xử lý."
          }
        }
      }
    },
    "Keyboard explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Bluetooth keyboard or Guacamole's on-screen keyboard. Its text input mode supports Vietnamese IME input."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng bàn phím Bluetooth hoặc bàn phím ảo trong menu Guacamole. Chế độ nhập văn bản hỗ trợ gõ tiếng Việt qua IME."
          }
        }
      }
    },
    "Performance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệu năng"
          }
        }
      }
    },
    "Performance explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For lower latency, locate the gateway near Windows, enable WebSocket and RDP Graphics Pipeline (GFX) when supported. Select a lower-resolution connection on weak networks. Speed/Balanced/Quality profiles are configured on the gateway; the app cannot force 60 FPS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để giảm độ trễ, đặt gateway gần VPS Windows, bật WebSocket và RDP Graphics Pipeline (GFX) nếu máy chủ hỗ trợ. Chọn kết nối độ phân giải thấp hơn khi mạng yếu. Các cấu hình Tốc độ/Cân bằng/Chất lượng được đặt trên gateway; ứng dụng không ép được 60 FPS."
          }
        }
      }
    },
