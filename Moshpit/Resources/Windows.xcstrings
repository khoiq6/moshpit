    "Native RDP help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native RDP help"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối RDP trực tiếp tới Windows đã bật Remote Desktop. Ưu tiên kết nối qua mạng riêng/VPN. Chỉ xác nhận chứng chỉ sau khi đối chiếu SHA-256 qua kênh quản trị tin cậy. Chuột Bluetooth phụ thuộc hỗ trợ của iOS. Chụm hai ngón để phóng to, giữ lâu để bấm phải; vuốt hai ngón để cuộn. FPS hiển thị là số khung hình gửi tới bộ hiển thị; độ trễ khung hình không phải RTT mạng."
          }
        }
      }
    },
