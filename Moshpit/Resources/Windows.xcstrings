      }
    },
    "Connect to Windows": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Windows"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối Windows"
          }
        }
      }
    },
    "Gateway explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the HTTPS address of an Apache Guacamole gateway you manage. Sign in there and select a configured Windows RDP connection. A raw IP:3389 is not a gateway URL."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần địa chỉ HTTPS của Apache Guacamole do bạn quản lý. Đăng nhập trên gateway, chọn máy Windows đã cấu hình RDP. Không nhập IP cổng 3389 trực tiếp vào ô này."
          }
        }
      }
    },
    "Controls and performance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls and performance"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển và hiệu năng"
          }
        }
      }
    },
    "Could not reach the gateway": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the gateway"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập gateway"
          }
        }
      }
    },
