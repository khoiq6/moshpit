      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux: yêu cầu khởi động lại sau một phút nếu có quyền sudo không mật khẩu. Windows: chỉ sao chép lệnh Restart-Computer để bạn chạy thủ công. Các phiên đang chạy có thể bị gián đoạn."
          }
        }
      }
